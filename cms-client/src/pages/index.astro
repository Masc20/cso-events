---
import Layout from '../layouts/Layout.astro';
import EventHero from '../components/EventHero.astro';
import EventCard from '../components/EventCard.astro';
import CommitteesBanner from '../components/CommitteesBanner.astro';
import { getEvents, getCommittees } from '../lib/api';

// Fetch events and committees using our centralized API layer
const events = await getEvents();
const { active: activeCommittees, upcoming: upcomingCommittees } = await getCommittees(events);

const featuredEvent = events.find((e) => e.featured) ?? events[0];
const externalEvents = events.filter((e) => e.hostType === 'External / Partner');

const filterOptions = [
  { label: 'All Events', filter: 'All' },
  ...activeCommittees.map((c) => ({ label: c.shortName, filter: c.shortName })),
  { label: 'Outside / Partner', filter: 'External' },
];
---

<Layout>
  <!-- Hero Section -->
  <EventHero totalCount={events.length} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-16">
    <!-- Official Committees Section with Central CSO Logo & Upcoming Committees (if present) -->
    <CommitteesBanner
      committees={activeCommittees}
      upcomingCommittees={upcomingCommittees}
    />

    <!-- Spotlight Featured Event -->
    {featuredEvent && (
      <section id="spotlight" class="relative rounded-2xl overflow-hidden bg-cso-surface border border-cso-border shadow-2xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 min-h-[420px]">
          <!-- Featured Image -->
          <div class="lg:col-span-7 relative min-h-[260px] lg:min-h-full bg-cso-subtle">
            <img
              src={featuredEvent.image}
              alt={featuredEvent.title}
              class="absolute inset-0 w-full h-full object-cover object-center"
            />
            <!-- Dynamic Theme Overlay Gradient (Adapts to light & dark canvas) -->
            <div class="absolute inset-0 overlay-spotlight-v lg:overlay-spotlight-h"></div>

            <div class="absolute top-5 left-5 flex items-center gap-2">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md bg-emerald-500 text-neutral-950 text-xs font-black uppercase tracking-wider shadow-lg">
                ★ Spotlight Event
              </span>
              <span class="px-2.5 py-1 rounded-md bg-cso-surface/90 backdrop-blur-md text-cso-primary border border-cso-border text-xs font-bold shadow-sm">
                {featuredEvent.category}
              </span>
              {featuredEvent.committeeName && (
                <span
                  class="px-2.5 py-1 rounded-md backdrop-blur-md text-xs font-bold border transition-colors shadow-sm"
                  style={`color: ${featuredEvent.committeeColor}; border-color: ${(featuredEvent.committeeColor)}50; background-color: var(--badge-bg);`}
                >
                  {featuredEvent.committeeName}
                </span>
              )}
            </div>
          </div>

          <!-- Featured Content -->
          <div class="lg:col-span-5 p-8 lg:p-10 flex flex-col justify-between space-y-6">
            <div class="space-y-3">
              <div class="flex items-center gap-2 text-xs font-mono font-bold text-cso-emerald">
                <span>{featuredEvent.formattedDate}</span>
                <span>•</span>
                <span>{featuredEvent.time}</span>
              </div>

              <h2 class="text-2xl sm:text-3xl font-black text-cso-primary tracking-tight leading-snug">
                {featuredEvent.title}
              </h2>

              <div class="flex items-center gap-2 text-xs font-semibold text-cso-secondary">
                {featuredEvent.organizerLogo && (
                  <img src={featuredEvent.organizerLogo} alt={featuredEvent.organizer} class="w-5 h-5 rounded-full object-contain bg-cso-subtle p-0.5 border border-cso-border shadow-sm" />
                )}
                <span>Host: <strong class="text-cso-primary">{featuredEvent.organizer}</strong></span>
              </div>

              <p class="text-xs text-cso-secondary leading-relaxed line-clamp-3 font-normal">
                {featuredEvent.description}
              </p>

              <div class="flex flex-wrap gap-1.5 pt-1">
                {featuredEvent.tags.map((tag) => (
                  <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-cso-subtle text-cso-muted border border-cso-border">
                    #{tag}
                  </span>
                ))}
              </div>
            </div>

            <div class="pt-4 border-t border-cso-border flex items-center justify-between gap-4">
              <div>
                <span class="block text-[10px] uppercase tracking-wider text-cso-muted font-medium">Access</span>
                <span class="text-sm font-black text-cso-primary">{featuredEvent.price}</span>
              </div>
              <a
                href={`/events/${featuredEvent.slug}`}
                class="inline-flex items-center justify-center px-4 py-2.5 rounded-md bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-xs uppercase tracking-wider shadow-md hover:scale-105 transition-all"
              >
                View Details
              </a>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- All Events Directory Grid Section -->
    <section id="events-grid" class="space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-cso-border pb-4">
        <div>
          <span class="text-xs font-black uppercase tracking-widest text-cso-emerald">Directory</span>
          <h2 class="text-2xl sm:text-3xl font-black text-cso-primary tracking-tight mt-0.5">Events Calendar</h2>
          <p class="text-xs sm:text-sm text-cso-muted mt-1">Search hackathons, workshops, esports tournaments, or filter by committee.</p>
        </div>
        <span id="results-count" class="text-xs font-mono font-bold text-cso-primary bg-cso-subtle px-3 py-1.5 rounded-md border border-cso-border self-start sm:self-auto shrink-0 shadow-sm">
          Showing {events.length} events
        </span>
      </div>

      <!-- Search & Filters Toolbar directly above Events -->
      <div class="space-y-3 bg-cso-surface border border-cso-border rounded-xl p-3 sm:p-4 shadow-md">
        <div class="relative flex items-center">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-cso-muted">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input
            id="event-search-input"
            type="text"
            placeholder="Search by keyword, event title, tech stack, or venue..."
            class="w-full pl-10 pr-4 py-2.5 bg-cso-subtle border border-cso-border rounded-lg text-cso-primary placeholder:text-cso-muted text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 transition-all"
          />
        </div>

        <!-- Filter Buttons Bar -->
        <div class="flex flex-wrap items-center gap-2 pt-0.5" id="category-filter-bar">
          <span class="text-[11px] uppercase tracking-wider font-extrabold text-cso-muted mr-1 hidden sm:inline">Filter:</span>
          {filterOptions.map((opt) => (
            <button
              type="button"
              data-filter={opt.filter}
              class={`filter-btn px-3 py-1.5 rounded-md text-xs font-bold border transition-all duration-200 cursor-pointer ${
                opt.filter === 'All'
                  ? 'bg-cso-primary text-cso-page border-cso-primary shadow-sm scale-105'
                  : 'bg-cso-surface text-cso-secondary border-cso-border hover:border-cso-strong hover:scale-102'
              }`}
            >
              {opt.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Events Card Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="events-container">
        {events.map((event) => (
          <div
            class="event-item"
            data-committee={event.committeeSlug ?? ''}
            data-host-type={event.hostType === 'External / Partner' ? 'external' : 'internal'}
            data-search={`${event.title} ${event.organizer} ${event.committeeName ?? ''} ${event.category} ${event.tags.join(' ')} ${event.venue}`.toLowerCase()}
          >
            <EventCard event={event} />
          </div>
        ))}
      </div>

      <!-- Empty State -->
      <div id="no-events-state" class={`${events.length === 0 ? '' : 'hidden'} text-center py-16 px-4 rounded-xl bg-cso-subtle border border-cso-border space-y-3`}>
        <div class="w-12 h-12 rounded-full bg-cso-surface text-cso-muted mx-auto flex items-center justify-center border border-cso-border shadow-sm">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="text-lg font-bold text-cso-primary">No matching events found</h3>
        <p class="text-xs text-cso-muted max-w-sm mx-auto">Try clearing your search query or selecting "All Events" to view upcoming activities.</p>
      </div>
    </section>

    <!-- Outside & Partner Events Section -->
    <section id="external-events" class="p-8 sm:p-10 rounded-2xl bg-cso-subtle border border-cso-border shadow-md space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-cso-border pb-6">
        <div>
          <div class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-widest text-cso-emerald mb-1">
            <span class="w-2 h-2 rounded-full bg-cso-emerald animate-pulse"></span>
            <span>External Tech Collaborations</span>
          </div>
          <h2 class="text-2xl font-black text-cso-primary tracking-tight">Outside &amp; Featured Events</h2>
          <p class="text-xs sm:text-sm text-cso-muted">Global hackathons, open source sprints, and tech conferences featured for CSO members.</p>
        </div>
        <span class="text-xs px-3 py-1.5 rounded-md bg-cso-surface text-cso-secondary font-mono border border-cso-border self-start sm:self-auto shadow-sm">
          {externalEvents.length} Partner Events
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {externalEvents.map((extEvent) => (
          <div class="p-6 rounded-xl bg-cso-surface border border-cso-border hover:border-cso-strong transition-all space-y-4 shadow-sm">
            <div class="flex items-start justify-between gap-3">
              <span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-sky-500/10 text-sky-600 dark:text-sky-400 border border-sky-500/20 uppercase tracking-wider">
                🌐 {extEvent.category}
              </span>
              <span class="text-xs text-cso-muted font-mono">{extEvent.formattedDate}</span>
            </div>

            <div>
              <h3 class="text-base sm:text-lg font-extrabold text-cso-primary hover:text-cso-emerald transition-colors">
                <a href={`/events/${extEvent.slug}`}>{extEvent.title}</a>
              </h3>
              <p class="text-xs text-cso-secondary mt-1 leading-relaxed">{extEvent.description}</p>
            </div>

            <div class="pt-3 border-t border-cso-border flex items-center justify-between text-xs">
              <span class="text-cso-muted font-medium">Partner: <strong class="text-cso-primary">{extEvent.organizer}</strong></span>
              <a href={`/events/${extEvent.slug}`} class="text-cso-emerald font-bold hover:underline flex items-center gap-1">
                <span>View Details</span>
                <span>→</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>

<!-- Interactive client-side search and filtering -->
<script>
  function setupEventDirectory() {
    const searchInput = document.getElementById('event-search-input') as HTMLInputElement | null;
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const committeeShortcutButtons = document.querySelectorAll<HTMLButtonElement>('.committee-shortcut-btn');
    const eventItems = document.querySelectorAll<HTMLElement>('.event-item');
    const countBadge = document.getElementById('results-count');
    const noEventsState = document.getElementById('no-events-state');

    let activeFilter = 'All';
    let searchQuery = '';

    function applyFilter() {
      let visibleCount = 0;

      eventItems.forEach((item) => {
        const committee = (item.getAttribute('data-committee') ?? '').toLowerCase();
        const hostType = item.getAttribute('data-host-type') ?? '';
        const itemSearch = item.getAttribute('data-search') ?? '';

        let matchesFilter = false;

        if (activeFilter === 'All') {
          matchesFilter = true;
        } else if (activeFilter === 'External') {
          matchesFilter = hostType === 'external';
        } else {
          matchesFilter = committee === activeFilter.toLowerCase();
        }

        const matchesSearch = !searchQuery || itemSearch.includes(searchQuery);

        if (matchesFilter && matchesSearch) {
          item.classList.remove('hidden');
          visibleCount++;
        } else {
          item.classList.add('hidden');
        }
      });

      if (countBadge) {
        countBadge.textContent = `Showing ${visibleCount} event${visibleCount === 1 ? '' : 's'}`;
      }

      if (noEventsState) {
        if (visibleCount === 0) {
          noEventsState.classList.remove('hidden');
        } else {
          noEventsState.classList.add('hidden');
        }
      }
    }

    function setFilterButtonActive(targetFilter: string) {
      filterButtons.forEach((btn) => {
        const btnFilter = btn.getAttribute('data-filter') ?? '';
        if (btnFilter.toLowerCase() === targetFilter.toLowerCase()) {
          btn.classList.remove('bg-cso-surface', 'text-cso-secondary', 'border-cso-border');
          btn.classList.add('bg-cso-primary', 'text-cso-page', 'border-cso-primary', 'shadow-sm', 'scale-105');
        } else {
          btn.classList.remove('bg-cso-primary', 'text-cso-page', 'border-cso-primary', 'shadow-sm', 'scale-105');
          btn.classList.add('bg-cso-surface', 'text-cso-secondary', 'border-cso-border');
        }
      });
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeFilter = btn.getAttribute('data-filter') ?? 'All';
        setFilterButtonActive(activeFilter);
        applyFilter();
      });
    });

    committeeShortcutButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const committee = btn.getAttribute('data-filter-committee') ?? 'All';
        activeFilter = committee;
        setFilterButtonActive(committee);
        applyFilter();

        const eventsGrid = document.getElementById('events-grid');
        eventsGrid?.scrollIntoView({ behavior: 'smooth' });
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = ((e.target as HTMLInputElement).value || '').trim().toLowerCase();
        applyFilter();
      });
    }
  }

  setupEventDirectory();
  document.addEventListener('astro:page-load', setupEventDirectory);
</script>
