---
import type { EventItem } from '../types';

interface Props {
  event: EventItem;
}

const { event } = Astro.props;

const isExternal = event.hostType === 'External / Partner';
const badgeColor = event.committeeColor;
---

<article
  class="event-card group relative flex flex-col rounded-xl bg-cso-surface border border-cso-border shadow-md overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl"
  style={`--event-accent: ${badgeColor};`}
>
  <!-- Image Banner -->
  <div class="relative aspect-[16/10] w-full overflow-hidden bg-cso-subtle">
    <img
      src={event.image}
      alt={event.title}
      loading="lazy"
      class="h-full w-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
    />
    <!-- Dynamic Theme Gradient Overlay -->
    <div class="absolute inset-0 overlay-card-image"></div>

    <!-- Host Badge (Top Left) -->
    <div class="absolute top-3 left-3 flex items-center gap-2">
      {event.organizerLogo ? (
        <div class="w-8 h-8 rounded-full bg-cso-subtle p-1 border border-cso-border flex items-center justify-center shadow-md">
          <img src={event.organizerLogo} alt={event.organizer} class="w-full h-full object-contain" />
        </div>
      ) : null}

      <span
        class="text-[10px] font-bold px-2.5 py-0.5 rounded-full border backdrop-blur-md transition-colors"
        style={
          isExternal
            ? 'color: #0284c7; border-color: rgba(2,132,199,0.3); background-color: rgba(2,132,199,0.1);'
            : `color: ${badgeColor}; border-color: ${badgeColor}50; background-color: ${badgeColor}18;`
        }
      >
        {isExternal ? '🌐 Outside Event' : event.committeeName ?? 'CSO Event'}
      </span>
    </div>

    <!-- Category Tag (Top Right) -->
    <span class="absolute top-3 right-3 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded bg-cso-surface/90 backdrop-blur-md text-cso-primary border border-cso-border shadow-sm">
      {event.category}
    </span>

    <!-- Date & Location Type (Bottom) -->
    <div class="absolute bottom-2.5 left-3 right-3 flex items-center justify-between text-xs font-semibold">
      <div
        class="flex items-center gap-1.5 bg-cso-surface/90 backdrop-blur-md px-2.5 py-1 rounded border border-cso-border transition-colors shadow-sm"
        style={`color: ${badgeColor};`}
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span class="font-mono text-[11px] font-bold">{event.formattedDate}</span>
      </div>

      <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded bg-cso-surface/90 backdrop-blur-md text-cso-secondary border border-cso-border shadow-sm">
        {event.locationType}
      </span>
    </div>
  </div>

  <!-- Content -->
  <div class="flex-1 p-5 flex flex-col justify-between space-y-4">
    <div class="space-y-2">
      <h3 class="event-title text-base sm:text-lg font-extrabold text-cso-primary transition-colors line-clamp-2">
        <a href={`/events/${event.slug}`}>
          <span class="absolute inset-0 z-10"></span>
          {event.title}
        </a>
      </h3>

      <p class="text-xs font-semibold text-cso-secondary">
        Host: <span class="text-cso-primary">{event.organizer}</span>
      </p>

      <p class="text-xs text-cso-secondary line-clamp-2 leading-relaxed">
        {event.description}
      </p>

      <!-- Tags -->
      <div class="flex flex-wrap gap-1.5 pt-1">
        {event.tags.slice(0, 3).map((tag) => (
          <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-cso-subtle text-cso-muted border border-cso-border">
            #{tag}
          </span>
        ))}
      </div>
    </div>

    <!-- Venue & CTA -->
    <div class="pt-3 border-t border-cso-border flex items-center justify-between text-xs text-cso-muted">
      <div class="flex items-center gap-1.5 truncate max-w-[190px]">
        <svg class="w-3.5 h-3.5 text-cso-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span class="truncate text-cso-secondary font-medium">{event.venue}</span>
      </div>

      <span
        class="event-cta inline-flex items-center gap-1 font-bold group-hover:translate-x-0.5 transition-all text-xs uppercase tracking-wider"
        style={`color: ${badgeColor};`}
      >
        Details →
      </span>
    </div>
  </div>
</article>
