---
import type { CommitteeItem } from '../types';
import { DEFAULT_COMMITTEE_COLOR, DEFAULT_COMMITTEE_LOGO, DEFAULT_ORGANIZER_LOGO } from '../types';

interface Props {
  committee: CommitteeItem;
  isUpcoming?: boolean;
}

const { committee, isUpcoming = false } = Astro.props;
const color = committee.accentColor || DEFAULT_COMMITTEE_COLOR;
const logo = committee.logo || (isUpcoming ? DEFAULT_COMMITTEE_LOGO : DEFAULT_ORGANIZER_LOGO);
const focusText = committee.focus || (isUpcoming ? 'Focus and objectives currently being drafted by student committee leaders.' : '');
---

<div
  class={`ribbon-banner ${isUpcoming ? '' : 'committee-shortcut-btn cursor-pointer'} group relative p-[2px] rounded-t-xl transition-all w-full sm:w-[calc(50%-0.5rem)] md:w-[calc(33.333%-0.75rem)] lg:w-[calc(20%-0.8rem)] shrink-0`}
  data-filter-committee={isUpcoming ? undefined : committee.shortName}
  style={`--comm-accent: ${color}; --comm-glow: ${color}50;`}
>
  <!-- Clipped Border Layer with dynamic gradient -->
  <div
    class="ribbon-clip w-full h-full p-[1.5px] rounded-t-xl transition-colors"
    style={`background: linear-gradient(180deg, ${color}90 0%, ${color}40 50%, ${color}20 100%);`}
  >
    <!-- Clipped Inner Card Surface -->
    <div class="ribbon-clip w-full h-full bg-cso-surface rounded-t-xl p-4 sm:p-5 pb-16 flex flex-col items-center text-center relative overflow-hidden transition-colors">
      <!-- Top Accent Gradient Line -->
      <div
        class="absolute top-0 inset-x-0 h-2 rounded-t-xl shadow-sm"
        style={`background: linear-gradient(90deg, transparent, ${color}, transparent);`}
      ></div>

      <!-- Circular Committee Logo Badge -->
      <div class="relative mt-2 mb-3 w-20 h-20 sm:w-24 sm:h-24 rounded-full p-2 bg-cso-subtle border border-cso-border shadow-md group-hover:scale-105 transition-transform flex items-center justify-center shrink-0">
        <img
          src={logo}
          alt={`${committee.name} Logo`}
          class="w-full h-full object-contain drop-shadow"
          loading="lazy"
        />
      </div>

      <!-- Badge (Active count vs In Formation pulse) -->
      {isUpcoming ? (
        <span
          class="inline-flex items-center gap-1.5 text-[10px] font-bold px-2.5 py-0.5 rounded-full border mb-2 transition-colors shrink-0 whitespace-nowrap"
          style={`color: ${color}; border-color: ${color}40; background-color: ${color}15;`}
        >
          <span class="w-1.5 h-1.5 rounded-full animate-pulse" style={`background-color: ${color};`}></span>
          In Formation
        </span>
      ) : (
        <span
          class="inline-flex items-center gap-1.5 text-[10px] font-bold px-2.5 py-0.5 rounded-full border mb-2 transition-colors shrink-0 whitespace-nowrap"
          style={`color: ${color}; border-color: ${color}40; background-color: ${color}15;`}
        >
          {committee.shortName} {committee.eventCount > 0 ? `(${committee.eventCount})` : ''}
        </span>
      )}

      <!-- Title -->
      <h4 class="text-sm sm:text-base font-black tracking-tight text-cso-primary mb-2 transition-colors leading-snug">
        {committee.name}
      </h4>

      <!-- Focus description -->
      <p class="text-xs text-cso-secondary leading-relaxed font-normal flex-1 mb-4 line-clamp-3 sm:line-clamp-none transition-colors">
        {focusText}
      </p>

      <!-- Bottom Action CTA -->
      <div class="w-full pt-3 border-t border-cso-border mt-auto">
        {isUpcoming ? (
          <div
            class="w-full py-1.5 px-2 rounded-md text-[11px] font-bold text-cso-muted flex items-center justify-center gap-1.5 bg-cso-subtle border border-cso-border"
          >
            <svg class="w-3 h-3 shrink-0" style={`color: ${color};`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Launching Soon</span>
          </div>
        ) : (
          <button
            type="button"
            data-filter-committee={committee.shortName}
            class="committee-shortcut-btn w-full py-1.5 px-2 rounded-md text-[11px] font-bold text-cso-secondary hover:text-cso-primary hover:bg-cso-subtle transition-all flex items-center justify-center gap-1 cursor-pointer"
          >
            <span>Explore Events</span>
            <svg class="w-3 h-3 group-hover:translate-x-1 transition-transform shrink-0" style={`color: ${color};`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        )}
      </div>
    </div>
  </div>
</div>
