{
  "name": "cms-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A Taproot CMS server",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "astro": "astro",
    "db:migrate": "node --experimental-strip-types ./scripts/migrate.ts",
    "db:migrate:remote": "node --experimental-strip-types ./scripts/migrate.ts --remote",
    "db:reindex": "node --experimental-strip-types ./scripts/reindex.ts",
    "deploy": "astro build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.5",
    "@astrojs/node": "^11.0.3",
    "@taprootcms/core": "^0.4.1",
    "@taprootcms/studio": "^0.4.1",
    "astro": "^7.1.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "wrangler": "^4.114.0"
  }
}
